# Copy this file to .env.local and fill in your Stripe test keys.
# Get these from https://dashboard.stripe.com/test/apikeys

STRIPE_SECRET_KEY=your_stripe_test_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_test_publishable_key

# Used to build the Stripe success/cancel redirect URLs.
# Leave as-is for local dev; set to your real domain in production.
NEXT_PUBLIC_BASE_URL=http://localhost:3000
